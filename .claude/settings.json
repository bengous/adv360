{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/fix-and-format.sh \"$(jq -r '.tool_input.file_path // empty')\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
